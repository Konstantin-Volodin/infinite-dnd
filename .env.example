# LLM Settings
# LLM_PROVIDER=local (default) uses the local llama.cpp server below.
# LLM_PROVIDER=anthropic uses the Claude API instead (needs ANTHROPIC_API_KEY; LlamaServer is skipped).
LLM_PROVIDER=local
LLM_AUTO_START=true
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=unsloth/gemma-4-26B-A4B-it-GGUF:UD-Q4_K_XL
LLM_PORT=1234

# Only used when LLM_PROVIDER=anthropic. Separate from LLM_MODEL so switching providers
# doesn't send the local GGUF model name to the Claude API.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5